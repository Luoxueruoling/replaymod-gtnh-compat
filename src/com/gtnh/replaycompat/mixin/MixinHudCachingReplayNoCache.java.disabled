package com.gtnh.replaycompat.mixin;

import com.replaymod.core.versions.MCVer;
import com.replaymod.replay.camera.CameraEntity;

import org.objectweb.asm.Opcodes;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Redirect;

import java.lang.reflect.Method;

/**
 * Makes Angelica's HUD cache step aside while a replay is being viewed, so ReplayMod can hide the
 * vanilla HUD again (the health bar being the visible symptom: "回放里还显示着血条").
 *
 * <h3>Why the previous attempt failed</h3>
 *
 * <p>{@code HUDCaching$HUDCachingHooks.shouldReturnEarly()} only guards the code <em>inside</em> the
 * HUD methods. The outer decision lives in {@code HUDCaching.renderCachedHud}, which - unless caching
 * is inactive - simply blits the previously rendered framebuffer and never re-runs {@code GuiIngame}:
 *
 * <pre>
 *   renderCachedHud(...):
 *     52: getstatic AngelicaConfig.hudCachingActive
 *     55: ifeq 80                       // caching off -&gt; render for real
 *     ...
 *     80: gi.func_73830_a(...)          // GuiIngame.renderGameOverlay  (the non-cached path)
 *     90: ClientEvent.post(POST_RENDER_HUD, ...)
 *     98: return
 *     99: ... nextHudRefresh / dirty ... framebuffer blit
 * </pre>
 *
 * <p>So the fix is to make that one read report <b>false</b> during a replay, which selects Angelica's
 * own non-cached branch - the same code path it takes when HUD caching is disabled outright, including
 * the surrounding {@code ClientEvent} calls. Vanilla then posts {@code RenderGameOverlayEvent} every
 * frame and ReplayMod's existing handler cancels the elements it always cancelled
 * (HEALTH/FOOD/ARMOR/AIR/HOTBAR/EXPERIENCE/...).
 *
 * <p>Outside replays the field is read unchanged, so the cache keeps doing its job for normal play.
 *
 * <p>{@code @At} note: field accesses need {@code value = "FIELD"} plus the ASM {@code opcode} - writing
 * {@code value = "GETSTATIC"} is rejected by Mixin at apply time (HANDOVER pit 51).
 */
@Mixin(targets = "com.gtnewhorizons.angelica.hudcaching.HUDCaching")
public abstract class MixinHudCachingReplayNoCache {

    private static Method getMinecraft;
    private static boolean resolved;

    @Redirect(method = "renderCachedHud",
            at = @At(value = "FIELD", opcode = Opcodes.GETSTATIC,
                    target = "Lcom/gtnewhorizons/angelica/config/AngelicaConfig;hudCachingActive:Z"),
            remap = false, require = 0)
    private static boolean replaycompat$disableHudCacheDuringReplay() {
        try {
            return !replaycompat$isReplay();
        } catch (Throwable ignored) {
            return true; // cannot tell -> leave Angelica's behaviour untouched
        }
    }

    private static boolean replaycompat$isReplay() throws Exception {
        if (!resolved) {
            resolved = true;
            try {
                Class<?> mcClass = Class.forName("net.minecraft.client.Minecraft");
                for (String name : new String[] { "getMinecraft", "func_71410_x" }) {
                    try {
                        getMinecraft = mcClass.getMethod(name);
                        break;
                    } catch (NoSuchMethodException ignored) {
                        // try the next spelling
                    }
                }
            } catch (Throwable t) {
                getMinecraft = null;
            }
        }
        if (getMinecraft == null) {
            return false;
        }
        Object mc = getMinecraft.invoke(null);
        if (mc == null) {
            return false;
        }
        Object view = MCVer.getRenderViewEntity((net.minecraft.client.Minecraft) mc);
        return view instanceof CameraEntity;
    }
}
